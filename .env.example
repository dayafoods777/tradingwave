# TradingWave Environment Configuration Example
NODE_ENV=development
PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database Connections
DATABASE_URL=postgresql://twave_user:twave_password@localhost:5432/tradingwave
TIMESCALE_URL=postgresql://twave_user:twave_password@localhost:5432/tradingwave

# Redis & Queues
REDIS_URL=redis://localhost:6379

# Security & Secrets
JWT_SECRET=tradingwave_super_secret_jwt_key_at_least_32_bytes_long
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Realtime WebSocket (Centrifugo)
CENTRIFUGO_API_KEY=tradingwave_centrifugo_secret_api_key
CENTRIFUGO_API_ENDPOINT=http://localhost:8000/api
CENTRIFUGO_WS_ENDPOINT=ws://localhost:8000/connection/websocket

# Safety Failsafe Guard
ALLOW_LIVE_TRADING=false

